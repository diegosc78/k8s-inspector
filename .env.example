# Copia a .env (ignorado por git) y rellena solo lo que uses.

# --- LLM para HolmesGPT (elige uno) ---
# Ver modelos: https://holmesgpt.dev
# OpenRouter (proveedor nativo de LiteLLM; ID de modelo tal como aparece en openrouter.ai)
OPENROUTER_API_KEY=
MODEL=openrouter/anthropic/claude-sonnet-4.5
# Alternativa: OpenRouter como endpoint genérico compatible con OpenAI
# OPENAI_API_KEY=sk-or-...
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# MODEL=openai/anthropic/claude-sonnet-4.5
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# Ollama local (sin API key): MODEL=ollama/llama3.1 y OLLAMA_API_BASE=http://host.docker.internal:11434
# MODEL=anthropic/claude-sonnet-4-5

# --- Prometheus ---
# Opción A (recomendada): port-forward automático dentro del contenedor (script `pf`)
PROM_NAMESPACE=monitoring
PROM_SERVICE=prometheus-operated
PROM_PORT=9090
# Opción B: Prometheus ya expuesto (ingress/LoadBalancer). Si se define, `pf` no es necesario.
# PROMETHEUS_URL=http://prometheus.homelab.lan


# --- Kubeconfig con ServiceAccount de solo lectura ---
# ./k8s/make-kubeconfig.sh > ~/.kube/k8s-inspector.config && chmod 600 ~/.kube/k8s-inspector.config
#KUBECONFIG_HOST=~/.kube/k8s-inspector.config
