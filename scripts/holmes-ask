#!/usr/bin/env bash
# HolmesGPT con port-forward a Prometheus (y Grafana si hay GRAFANA_API_KEY) si hace falta.
# Uso: holmes-ask "por qué falla el pod X?"
set -euo pipefail
if [ -z "${PROMETHEUS_URL:-}" ]; then pf >/dev/null || true; export PROMETHEUS_URL="http://localhost:${PROM_PORT:-9090}"; fi
if [ -n "${GRAFANA_API_KEY:-}" ] && [ -z "${GRAFANA_URL:-}" ]; then pf grafana >/dev/null || true; export GRAFANA_URL="http://localhost:${GRAFANA_PORT:-3000}"; fi
exec holmes ask "$@"
