#!/usr/bin/env bash
# Port-forward en segundo plano. Uso: pf [prometheus|grafana|stop]   (sin args: prometheus)
set -euo pipefail
ACTION="${1:-prometheus}"
declare -A NS SVC RPORT LPORT
NS[prometheus]="${PROM_NAMESPACE:-monitoring}"; SVC[prometheus]="${PROM_SERVICE:-prometheus-operated}"
RPORT[prometheus]="${PROM_PORT:-9090}";         LPORT[prometheus]="${PROM_PORT:-9090}"
NS[grafana]="${GRAFANA_NAMESPACE:-monitoring}"; SVC[grafana]="${GRAFANA_SERVICE:-prom-grafana}"
RPORT[grafana]="${GRAFANA_REMOTE_PORT:-80}";    LPORT[grafana]="${GRAFANA_PORT:-3000}"

if [ "$ACTION" = stop ]; then
  for t in prometheus grafana; do
    f=/tmp/pf-$t.pid; [ -f $f ] && { kill "$(cat $f)" 2>/dev/null || true; rm -f $f; }
  done
  exit 0
fi
[ -n "${SVC[$ACTION]:-}" ] || { echo "Uso: pf [prometheus|grafana|stop]" >&2; exit 1; }

PIDFILE=/tmp/pf-$ACTION.pid; LOG=/tmp/pf-$ACTION.log; PORT=${LPORT[$ACTION]}
if [ -f $PIDFILE ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then echo "Ya activo"; exit 0; fi
kubectl -n "${NS[$ACTION]}" port-forward "svc/${SVC[$ACTION]}" "$PORT:${RPORT[$ACTION]}" >$LOG 2>&1 &
echo $! > $PIDFILE
for _ in $(seq 20); do nc -z localhost "$PORT" 2>/dev/null && { echo "$ACTION -> http://localhost:$PORT"; exit 0; }; sleep 0.5; done
echo "Fallo el port-forward:"; cat $LOG; exit 1
