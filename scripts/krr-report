#!/usr/bin/env bash
# Ejecuta KRR y guarda el resultado JSON con fecha en ~/reports/ (para comparar con `krr-diff`).
# Uso: krr-report [args de krr]   p. ej.: krr-report -n kube-system
# Variable: REPORTS_DIR (por defecto ~/reports)
set -euo pipefail
DIR="${REPORTS_DIR:-$HOME/reports}"; mkdir -p "$DIR"
# Sufijo con los namespaces pedidos (-n a,b), para no mezclar informes de distinto alcance
SUFFIX=""; prev=""
for a in "$@"; do
  { [ "$prev" = -n ] || [ "$prev" = --namespace ]; } && SUFFIX="-${a//[^A-Za-z0-9._-]/_}"
  prev="$a"
done
OUT="$DIR/krr-$(date +%Y%m%d-%H%M%S)${SUFFIX}.json"
krr-run -f json -q "$@" > "$OUT.tmp" && mv "$OUT.tmp" "$OUT" || { rm -f "$OUT.tmp"; echo "KRR falló; no se guardó informe" >&2; exit 1; }
echo "Informe: $OUT  (score KRR: $(jq .score "$OUT"), contenedores: $(jq '.scans|length' "$OUT"))"
